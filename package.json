{
  "name": "nova",
  "private": true,
  "version": "0.2.0",
  "description": "Nova - a voice-first, model-agnostic agentic OS layer",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n daemon,ui -c magenta,cyan \"npm:dev:daemon\" \"npm:dev:ui\"",
    "dev:daemon": "npm run dev -w @nova/daemon",
    "dev:ui": "npm run dev -w @nova/desktop",
    "dev:tauri": "npm run tauri -w @nova/desktop -- dev",
    "jev:ping": "npm run jev:ping -w @nova/daemon",
    "reflex:download": "npm run reflex:download -w @nova/daemon",
    "voice:download": "npm run voice:download -w @nova/daemon",
    "hearing:download": "npm run hearing:download -w @nova/daemon",
    "hearing:build": "npm run hearing:build -w @nova/daemon",
    "apple:build": "npm run apple:build -w @nova/daemon",
    "app": "npm run app -w @nova/daemon --",
    "phone": "npm run phone -w @nova/daemon --",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @nova/desktop",
    "readme:media": "npm run readme:media -w @nova/desktop",
    "readme:phone": "npm run readme:phone -w @nova/daemon"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
