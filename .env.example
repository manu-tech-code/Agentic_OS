# Copy to .env and fill in. Nothing here is required: with no keys, Nova runs
# on the offline heuristic decision engine so you can build the UI and voice loop.

# Vercel AI Gateway key - gives access to Jev (typesafe-ai/jev) without the
# TypeSafe waitlist, plus Claude/GPT/Gemini for System 2.
# Create one at: Vercel dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=

# System 1 (decisions): auto | jev | llm | heuristic
#   auto = jev when AI_GATEWAY_API_KEY is set, otherwise heuristic
NOVA_DECISION_ENGINE=auto
# Used when the primary engine errors or exceeds NOVA_DECISION_TIMEOUT_MS: llm | heuristic | none
NOVA_DECISION_FALLBACK=heuristic
NOVA_DECISION_TIMEOUT_MS=1500
# Pin a version once you tune thresholds (e.g. typesafe-ai/jev-1.13.0 if the gateway exposes it)
NOVA_JEV_MODEL=typesafe-ai/jev

# System 2 (reasoning / chat). Any AI Gateway model id. Leave empty to disable.
NOVA_BRAIN_MODEL=anthropic/claude-sonnet-5

# Wake word(s), comma separated
NOVA_WAKE_WORDS=nova,hey nova,okay nova

# Daemon port (UI connects to ws://127.0.0.1:<port>)
NOVA_PORT=7878
