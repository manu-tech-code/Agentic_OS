<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- What Xcode can't write from build settings (the rest is generated): Bonjour, nova:// pairing links,
	     finishing a reply out of the front - answering Siri, or after the phone was locked (never the microphone) -
	     and checking in with the Mac when iOS lets it (Background App Refresh: a free Apple account has no push). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.nova.phone.check-in</string>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_nova._tcp</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.nova.phone.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nova</string>
			</array>
		</dict>
	</array>
	<!-- The Keychain group shared by the app and its widgets, with the team's prefix (Shared/WidgetState.swift). -->
	<key>NovaSharedKeychain</key>
	<string>$(AppIdentifierPrefix)dev.nova.phone.shared</string>
</dict>
</plist>
